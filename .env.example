# Public read-only configuration used by the portfolio frontend.
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-20

# Server-only. Read token (Viewer role) used to unlock confidential side quests.
# Create one in sanity.io/manage → API → Tokens. Never prefix with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=

# Spotify (server-only), for the Listening section. Create an app at developer.spotify.com,
# add the redirect URI http://127.0.0.1:8888/callback, fill in the ID and secret, then run
# `npm run spotify:auth` to get the refresh token.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
